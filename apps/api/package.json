{
  "name": "@bakimos/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/seed.ts\"",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "jest --config jest.config.cjs --runInBand && jest --config jest-e2e.config.cjs --runInBand",
    "test:unit": "jest --config jest.config.cjs --runInBand",
    "test:e2e": "jest --config jest-e2e.config.cjs --runInBand"
  },
  "dependencies": {
    "@bakimos/api-contracts": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@prisma/client": "6.19.3",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.8",
    "helmet": "8.3.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "xlsx": "0.18.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.7",
    "@types/bcrypt": "6.0.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/multer": "1.4.13",
    "@types/node": "22.20.5",
    "@types/passport-jwt": "4.0.1",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.4",
    "jest": "30.5.2",
    "pg": "8.23.1",
    "prisma": "6.19.3",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"

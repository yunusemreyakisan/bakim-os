generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MembershipRole {
  SUPER_ADMIN
  ADMIN
  MAINTENANCE_MANAGER
  TECHNICIAN
  OPERATOR
  WAREHOUSE
}

enum EquipmentStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum FaultStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  CLOSED
  CANCELLED
}

enum FaultPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum WorkOrderStatus {
  OPEN
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum WorkActivityKind {
  NOTE
  ACTION
}

enum SyncOpType {
  FAULT_CREATE
}

enum SyncOpStatus {
  APPLIED
  DUPLICATE
  REJECTED
  CONFLICT
}

enum MaintenanceCadence {
  DAILY
  WEEKLY
  MONTHLY
}

enum MaintenanceTaskStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum StockReason {
  RECEIPT
  ISSUE
  ADJUSTMENT
  WORK_ORDER
}

model Tenant {
  id          String         @id @default(uuid())
  name        String
  slug        String         @unique
  status      TenantStatus   @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  sites       Site[]
  memberships Membership[]
  equipment   Equipment[]
  faults             Fault[]
  auditLogs          AuditLog[]
  workOrders         WorkOrder[]
  workOrderActivities WorkOrderActivity[]
  sequences          TenantSequence[]
  syncOperations      SyncOperation[]
  maintenancePlans    MaintenancePlan[]
  maintenanceTasks    MaintenanceTask[]
  parts               Part[]
  stockBalances       StockBalance[]
  stockMovements      StockMovement[]
  workOrderPartUses   WorkOrderPartUse[]
  attachments         Attachment[]

  @@map("tenants")
}

model Site {
  id        String      @id @default(uuid())
  tenantId  String
  name      String
  timezone  String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  equipment Equipment[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("sites")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  passwordHash  String
  status        UserStatus     @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  memberships   Membership[]
  refreshTokens RefreshToken[]
  faults                 Fault[]              @relation("FaultReporter")
  auditLogs              AuditLog[]
  assignedWorkOrders     WorkOrder[]          @relation("WorkOrderAssignee")
  createdWorkOrders      WorkOrder[]          @relation("WorkOrderCreator")
  workOrderActivities    WorkOrderActivity[]
  syncOperations           SyncOperation[]
  assignedMaintenancePlans MaintenancePlan[]     @relation("MaintenancePlanAssignee")
  assignedMaintenanceTasks MaintenanceTask[]     @relation("MaintenanceTaskAssignee")
  completedMaintenance     MaintenanceTask[]     @relation("MaintenanceTaskCompleter")
  stockMovements           StockMovement[]
  attachments              Attachment[]

  @@map("users")
}

model Membership {
  id        String         @id @default(uuid())
  tenantId  String
  userId    String
  role      MembershipRole
  createdAt DateTime       @default(now())
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

model Equipment {
  id          String          @id @default(uuid())
  tenantId    String
  siteId      String
  code        String
  name        String
  description String?
  status      EquipmentStatus @default(ACTIVE)
  qrPublicId  String          @unique
  version     Int             @default(1)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  site        Site            @relation(fields: [siteId], references: [id], onDelete: Restrict)
  faults           Fault[]
  workOrders       WorkOrder[]
  maintenancePlans MaintenancePlan[]
  maintenanceTasks MaintenanceTask[]

  @@unique([tenantId, code])
  @@index([tenantId, siteId])
  @@index([tenantId, status])
  @@map("equipment")
}

model Fault {
  id          String        @id @default(uuid())
  tenantId    String
  equipmentId String
  reporterId  String
  description String
  status      FaultStatus   @default(OPEN)
  priority    FaultPriority @default(MEDIUM)
  acknowledgedAt DateTime?
  closedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  equipment   Equipment     @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  reporter    User          @relation("FaultReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  workOrders  WorkOrder[]

  @@index([tenantId, createdAt])
  @@index([tenantId, equipmentId])
  @@index([tenantId, status])
  @@index([tenantId, closedAt])
  @@map("faults")
}

model WorkOrder {
  id           String          @id @default(uuid())
  tenantId     String
  faultId      String
  equipmentId  String
  number       String
  title        String
  description  String?
  status       WorkOrderStatus @default(OPEN)
  version      Int             @default(1)
  assigneeId   String?
  createdById  String
  openedAt     DateTime        @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  fault        Fault           @relation(fields: [faultId], references: [id], onDelete: Restrict)
  equipment    Equipment       @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  assignee     User?           @relation("WorkOrderAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy    User            @relation("WorkOrderCreator", fields: [createdById], references: [id], onDelete: Restrict)
  activities      WorkOrderActivity[]
  partUses        WorkOrderPartUse[]
  stockMovements  StockMovement[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, assigneeId])
  @@index([tenantId, faultId])
  @@index([tenantId, equipmentId])
  @@map("work_orders")
}

model WorkOrderActivity {
  id          String           @id @default(uuid())
  tenantId    String
  workOrderId String
  actorId     String
  kind        WorkActivityKind
  description String
  createdAt   DateTime         @default(now())
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  workOrder   WorkOrder        @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  actor       User             @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([tenantId, workOrderId, createdAt])
  @@map("work_order_activities")
}

model TenantSequence {
  tenantId String
  name     String
  value    Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, name])
  @@map("tenant_sequences")
}

model SyncOperation {
  id             String       @id @default(uuid())
  tenantId       String
  userId         String
  deviceId       String
  operationId    String
  type           SyncOpType
  payloadHash    String
  status         SyncOpStatus
  entityType     String?
  entityId       String?
  resultCode     String?
  resultMessage  String?
  clientCreatedAt DateTime
  createdAt      DateTime     @default(now())
  processedAt    DateTime     @default(now())
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([tenantId, operationId])
  @@index([tenantId, userId, createdAt])
  @@map("sync_operations")
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model MaintenancePlan {
  id          String              @id @default(uuid())
  tenantId    String
  equipmentId String
  title       String
  description String?
  cadence     MaintenanceCadence
  interval    Int                 @default(1)
  nextDueAt   DateTime
  active      Boolean             @default(true)
  assigneeId  String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  equipment   Equipment           @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  assignee    User?               @relation("MaintenancePlanAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  items       MaintenancePlanItem[]
  tasks       MaintenanceTask[]

  @@index([tenantId, nextDueAt])
  @@index([tenantId, equipmentId])
  @@map("maintenance_plans")
}

model MaintenancePlanItem {
  id        String          @id @default(uuid())
  tenantId  String
  planId    String
  sortOrder Int
  label     String
  required  Boolean         @default(true)
  plan      MaintenancePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, sortOrder])
  @@map("maintenance_plan_items")
}

model MaintenanceTask {
  id            String                @id @default(uuid())
  tenantId      String
  planId        String
  equipmentId   String
  title         String
  dueAt         DateTime
  status        MaintenanceTaskStatus @default(OPEN)
  version       Int                   @default(1)
  assigneeId    String?
  completedAt   DateTime?
  completedById String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plan          MaintenancePlan       @relation(fields: [planId], references: [id], onDelete: Restrict)
  equipment     Equipment             @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  assignee      User?                 @relation("MaintenanceTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  completedBy   User?                 @relation("MaintenanceTaskCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  items         MaintenanceCheckItem[]

  @@index([tenantId, status, dueAt])
  @@index([tenantId, equipmentId, status])
  @@index([tenantId, planId, status])
  @@map("maintenance_tasks")
}

model MaintenanceCheckItem {
  id        String          @id @default(uuid())
  tenantId  String
  taskId    String
  sortOrder Int
  label     String
  required  Boolean
  checked   Boolean         @default(false)
  note      String?
  task      MaintenanceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, sortOrder])
  @@map("maintenance_check_items")
}

model Part {
  id          String          @id @default(uuid())
  tenantId    String
  code        String
  name        String
  unit        String          @default("adet")
  minQuantity Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  balance     StockBalance?
  movements   StockMovement[]
  uses        WorkOrderPartUse[]

  @@unique([tenantId, code])
  @@index([tenantId, name])
  @@map("parts")
}

model StockBalance {
  id        String   @id @default(uuid())
  tenantId  String
  partId    String   @unique
  quantity  Int      @default(0)
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  part      Part     @relation(fields: [partId], references: [id], onDelete: Restrict)

  @@unique([tenantId, partId])
  @@map("stock_balances")
}

model StockMovement {
  id            String     @id @default(uuid())
  tenantId      String
  partId        String
  actorId       String
  reason        StockReason
  delta         Int
  quantityAfter Int
  workOrderId   String?
  operationId   String?
  note          String?
  createdAt     DateTime   @default(now())
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  part          Part       @relation(fields: [partId], references: [id], onDelete: Restrict)
  actor         User       @relation(fields: [actorId], references: [id], onDelete: Restrict)
  workOrder     WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  partUse       WorkOrderPartUse?

  @@unique([tenantId, operationId])
  @@index([tenantId, partId, createdAt])
  @@index([tenantId, createdAt])
  @@map("stock_movements")
}

model WorkOrderPartUse {
  id          String        @id @default(uuid())
  tenantId    String
  workOrderId String
  partId      String
  movementId  String        @unique
  quantity    Int
  createdAt   DateTime      @default(now())
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  workOrder   WorkOrder     @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  part        Part          @relation(fields: [partId], references: [id], onDelete: Restrict)
  movement    StockMovement @relation(fields: [movementId], references: [id], onDelete: Restrict)

  @@index([tenantId, workOrderId])
  @@map("work_order_part_uses")
}

model Attachment {
  id           String   @id @default(uuid())
  tenantId     String
  entityType   String
  entityId     String
  fileName     String
  contentType  String
  size         Int
  storageKey   String
  uploadedById String
  createdAt    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([tenantId, entityType, entityId])
  @@map("attachments")
}

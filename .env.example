# Yerel geliştirme örneği. Kopyalayıp .env yapın. Bu değerler üretim sırrı değildir.
NODE_ENV=development

API_PORT=3001
API_INTERNAL_URL=http://127.0.0.1:3001
WEB_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Docker Compose varsayılanı. scripts/dev-postgres.sh kullanıyorsanız port 5433 ve parolasız kullanıcıdır:
# postgresql://bakimos@127.0.0.1:5433/bakimos
DATABASE_URL=postgresql://bakimos:bakimos@127.0.0.1:5432/bakimos

# En az 32 karakter. Üretimde dev-only içeren değerler süreç açılışında reddedilir.
JWT_ACCESS_SECRET=dev-only-change-this-access-secret-32b
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Kiracı oluşturma kapısı. Herkese açık kayıt yoktur.
TENANT_BOOTSTRAP_TOKEN=dev-only-bootstrap-token

# Yalnızca seed. Üretimde seed komutu çalışmaz.
SEED_PASSWORD=DevOnly-Change-Me-1

BCRYPT_COST=12
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
LOGIN_THROTTLE_LIMIT=5
TRUST_PROXY=false
STORAGE_ROOT=./var/storage
SENTRY_DSN=
